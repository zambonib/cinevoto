rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfil dos usuários autenticados
    match /usuarios/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Salas de votação e subcoleções (votos e filmes assistidos)
    match /salas/{salaId} {
      allow read, write: if request.auth != null;
      
      match /assistidos/{docId} {
        allow read, write: if request.auth != null;
      }
      
      match /votos/{docId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
