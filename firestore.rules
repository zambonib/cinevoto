rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfil dos usuários autenticados
    match /usuarios/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Salas de votação e subcoleções (votos e filmes assistidos)
    match /salas/{salaId} {
      allow read, write: if request.auth != null;
      
      match /assistidos/{docId} {
        allow read, write: if request.auth != null;
      }
      
    // Segurança de IPs e bloqueios anti-força bruta (72 horas)
    match /seguranca_ips/{ipId} {
      allow read, write: if true;
    }

    // Vouchers de convite para cadastro e acesso
    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
